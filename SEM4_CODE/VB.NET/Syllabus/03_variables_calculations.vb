Imports System

Module CalculationsDemo
    Sub Main()
        Const PI As Double = 3.14159                  ' Assign variable value
        Dim radius As Double = 5.0                    ' Initialize variable
        Dim area As Double = PI * radius * radius     ' Initialize variable
        Console.WriteLine("Radius: " & radius)        ' Display console output
        Console.WriteLine("Area of Circle: " & area)  ' Display console output
    End Sub
End Module
