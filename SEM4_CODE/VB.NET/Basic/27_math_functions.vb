Imports System

Module MathFunctionsDemo
    Sub Main()
        Console.WriteLine("Math.Abs(-25)    : " & Math.Abs(-25))        ' Print output to console
        Console.WriteLine("Math.Sqrt(81)    : " & Math.Sqrt(81))        ' Print output to console
        Console.WriteLine("Math.Pow(3, 4)   : " & Math.Pow(3, 4))       ' Print output to console
        Console.WriteLine("Math.Round(5.67) : " & Math.Round(5.67))     ' Print output to console
        Console.WriteLine("Math.Floor(5.99) : " & Math.Floor(5.99))     ' Print output to console
        Console.WriteLine("Math.Ceiling(5.01): " & Math.Ceiling(5.01))  ' Print output to console
        Console.WriteLine("Math.Max(12, 45) : " & Math.Max(12, 45))     ' Print output to console
        Console.WriteLine("Math.Min(12, 45) : " & Math.Min(12, 45))     ' Print output to console
    End Sub
End Module
